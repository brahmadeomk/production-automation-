[Unit]
Description=Daily backup of the programming station database and reports

[Timer]
# 22:30 local time, with a jitter so a line of stations does not hit the
# file server all at once.
OnCalendar=*-*-* 22:30:00
RandomizedDelaySec=15m
# Catch up if the station was switched off at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
