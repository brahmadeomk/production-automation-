# Display configuration for the station, read by progstation.service.
# Edit this rather than the unit file; a reinstall keeps your choice.

# Qt platform plugin. Pick the one that matches how the Pi is set up:
#
#   xcb      the Raspberry Pi desktop is running (you can VNC into it).
#            Use this whenever a desktop session owns the screen -- linuxfb
#            would fight the X server for the display and you get a black
#            screen or a flickering console.
#
#   linuxfb  console only, no desktop installed. Draws straight to the
#            framebuffer. Lightest option for a dedicated station.
#
#   eglfs    console only, with GPU acceleration. Try this if linuxfb shows
#            nothing on an HDMI panel.
#
QT_QPA_PLATFORM=xcb

# Needed only for xcb: which X display to attach to, and the cookie that
# authorises it. :0 is the desktop on the Pi's own screen.
DISPLAY=:0
XAUTHORITY=/home/pi/.Xauthority

# Rotate the panel if the vendor overlay does not (0, 90, 180, 270).
# QT_QPA_EGLFS_ROTATION=180
